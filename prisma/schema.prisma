generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(INTERN)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  createdQuizzes Quiz[]           @relation("QuizCreator")
  assignments    QuizAssignment[]
  attempts       QuizAttempt[]

  @@map("users")
}

enum Role {
  ADMIN
  INTERN
}

model Quiz {
  id               String   @id @default(uuid())
  title            String
  description      String?
  timeLimitMinutes Int
  passingScore     Int      @default(60)
  shuffleQuestions Boolean  @default(false)
  maxViolations    Int      @default(3)
  isPublished      Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  createdBy   User             @relation("QuizCreator", fields: [createdById], references: [id])
  questions   Question[]
  assignments QuizAssignment[]
  attempts    QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id        String       @id @default(uuid())
  quizId    String
  type      QuestionType @default(MCQ)
  text      String
  points    Int          @default(1)
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]

  @@map("questions")
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

model Option {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@map("options")
}

model QuizAssignment {
  id           String    @id @default(uuid())
  quizId       String
  internId     String
  assignedById String
  dueDate      DateTime?
  startAt      DateTime?
  endAt        DateTime?
  assignedAt   DateTime  @default(now())

  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  intern User @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, quizId])
  @@map("quiz_assignments")
}

model QuizAttempt {
  id               String        @id @default(uuid())
  quizId           String
  internId         String
  status           AttemptStatus @default(IN_PROGRESS)
  score            Int?
  totalPoints      Int?
  percentage       Float?
  passed           Boolean?
  violations       Int           @default(0)
  autoSubmitted    Boolean       @default(false)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int?

  quiz       Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  intern     User        @relation(fields: [internId], references: [id], onDelete: Cascade)
  answers    Answer[]
  violationLogs Violation[]

  @@map("quiz_attempts")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  TERMINATED
}

model Answer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean?
  answeredAt       DateTime @default(now())

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@map("answers")
}

model Violation {
  id          String        @id @default(uuid())
  attemptId   String
  type        ViolationType
  description String?
  timestamp   DateTime      @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("violations")
}

enum ViolationType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
  DEVTOOLS_OPEN
  WINDOW_BLUR
  CONTEXT_MENU
}
